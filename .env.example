# Formspree form endpoint ID (from https://formspree.io/forms → your form → Integration).
# Copy this file to .env and fill in the real value.
VITE_FORMSPREE_ID=

# Privyr incoming webhook URL (from the Privyr app → Integrations → Webhooks).
# Optional — leads still submit fine without it, just skip the Privyr CRM sync.
VITE_PRIVYR_WEBHOOK_URL=
