# Formspree form endpoint ID (from https://formspree.io/forms → your form → Integration).
# Copy this file to .env and fill in the real value.
VITE_FORMSPREE_ID=

# Privyr incoming webhook URL (from the Privyr app → Integrations → Webhooks).
# Optional — leads still submit fine without it, just skip the Privyr CRM sync.
VITE_PRIVYR_WEBHOOK_URL=

# Prosper CRM lead webhook URL, including the "Website" API key
# (CRM → Settings → Webhook keys). Optional — leads still submit fine
# without it, just skip the Prosper CRM sync.
VITE_CRM_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Online shop (server side). Set these in Vercel -> Project -> Settings ->
# Environment Variables. NEVER prefix them with VITE_ and never commit real values.
# With none of them set, `npm run dev` runs the shop against a local test store
# in .shop-dev/ (orders and emails are saved there, nothing is sent).
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Any long random text (32+ characters). Signs sign-in sessions.
SESSION_SECRET=
# Comma-separated emails that can always sign in to /admin.
ADMIN_EMAILS=
RESEND_API_KEY=
EMAIL_FROM=Prosper Infotech Shop <orders@prosperinfotech.com>
# Who gets "new order" and "low stock" emails (comma-separated).
SALES_NOTIFY_EMAIL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Public address of the site, used in email links.
SITE_URL=https://shop.prosperinfotech.com
# Same address, for the browser (canonical links). Safe to be public.
VITE_SHOP_URL=https://shop.prosperinfotech.com
# Optional, later: Shiprocket automation.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=
